# ---- AI (multi-model fallback chain; models without a key are skipped; no key at all = keyword rules) ----
GEMINI_API_KEY=            # https://aistudio.google.com/apikey
GROQ_API_KEY=              # https://console.groq.com/keys (free, very fast)
NVIDIA_API_KEY=            # https://build.nvidia.com (free credits)
OPENROUTER_API_KEY=        # https://openrouter.ai/keys (":free" models)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# AI_CHAIN=gemini:gemini-3.6-flash,gemini:gemini-3.5-flash,groq:llama-3.3-70b-versatile,openrouter:openrouter/free
AI_TIMEOUT_MS=10000        # per model, while another model is left to try
AI_TOTAL_BUDGET_MS=30000   # whole answer
AI_HEDGE_MS=6000           # start the next model in parallel if the current one is silent this long (0 = off)
AI_BATCH_SIZE=15           # reviews per prompt
AI_CONCURRENCY=3           # prompts in parallel

# ---- Collection ----
AMAZON_DOMAIN=amazon.com   # default marketplace for bare ASINs (amazon.de, amazon.co.uk, amazon.ae, amazon.sa ...)
MAX_REVIEWS=300            # per product
STARS=critical             # critical (1-3) | all | positive | 1,2
PAGES_PER_FILTER=10        # Amazon shows at most ~10 pages per star filter + sort order
PAGE_DELAY_MS=3500         # pause between review pages (randomised)
PRODUCT_DELAY_MS=6000      # pause between products
ENGINE=auto                # auto (HTTP, then Chrome) | http | browser
HEADLESS=true              # false = visible Chrome window (you can handle Amazon checks yourself)
# CHROME_PATH=             # auto-detected (Chrome / Edge); set if Chrome lives elsewhere
# CHROME_PROFILE_DIR=./data/chrome-profile   # where `login` keeps the Amazon session
# PROXY_URL=http://user:pass@host:port        # residential proxy for heavy use
# DEBUG_DIR=./data/debug                     # screenshots of failed page loads

# ---- Output ----
# PROJECT=default
# DATA_DIR=./data
# OUT_DIR=./out
